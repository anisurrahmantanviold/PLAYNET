rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // User avatars and covers
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Post media (Images and Videos)
    match /posts/{postId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Direct message attachments & voice notes
    match /chats/{chatId}/{fileName} {
      allow read, write: if isAuthenticated()
                         && request.resource.size < 25 * 1024 * 1024;
    }

    // Community media
    match /communities/{communityId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
